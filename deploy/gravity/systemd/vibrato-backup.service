[Unit]
Description=Vibrato data backup
After=vibrato.service

[Service]
Type=oneshot
User=vibrato
Group=vibrato
ExecStart=/opt/vibrato/app/deploy/gravity/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vibrato/data /opt/vibrato/host-backups
UMask=0027
