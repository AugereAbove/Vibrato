VIBRATO_HOST=127.0.0.1
VIBRATO_PORT=8765
VIBRATO_WORKERS=2
VIBRATO_DATA_DIR=/opt/vibrato/data
VIBRATO_FRONTEND_DIST=/opt/vibrato/app/frontend/dist
VIBRATO_APP_BASE_URL=
VIBRATO_ALLOWED_ORIGINS=
VIBRATO_TRUSTED_HOSTS=
VIBRATO_DETERMINISTIC=0
VIBRATO_NEURAL=0

# The systemd unit makes /opt/vibrato/app read-only (ProtectSystem=strict), so
# numba's @njit(cache=True) can't write its compilation cache next to the
# source file there. Point it at the one writable path the service has.
NUMBA_CACHE_DIR=/opt/vibrato/data/numba-cache
